## Proposed Changes

### Phase 1 — Database Migrations (Store Supabase)

#### [NEW] `supabase/migrations/20260601100000_m26_product_segmentation_metadata.sql`

```sql
-- إضافة حقول الـ segmentation لجدول products
ALTER TABLE public.products
  ADD COLUMN IF NOT EXISTS target_audience  TEXT[]  NOT NULL DEFAULT ARRAY['all'],
  ADD COLUMN IF NOT EXISTS business_type_tags TEXT[] NOT NULL DEFAULT ARRAY['all'],
  ADD COLUMN IF NOT EXISTS product_use_case TEXT    NULL,
  ADD COLUMN IF NOT EXISTS visible_in       TEXT[]  NOT NULL DEFAULT ARRAY['web_store'],
  ADD COLUMN IF NOT EXISTS purchase_mode    TEXT[]  NOT NULL DEFAULT ARRAY['retail'],
  ADD COLUMN IF NOT EXISTS is_b2b_offer     BOOLEAN NOT NULL DEFAULT false,
  ADD COLUMN IF NOT EXISTS requires_verified_salon BOOLEAN NOT NULL DEFAULT false,
  ADD COLUMN IF NOT EXISTS min_order_qty    INT     NULL,
  ADD COLUMN IF NOT EXISTS max_order_qty    INT     NULL;

-- GIN indexes للبحث الفعّال
CREATE INDEX IF NOT EXISTS idx_products_target_audience_gin   ON public.products USING GIN (target_audience);
CREATE INDEX IF NOT EXISTS idx_products_business_type_tags_gin ON public.products USING GIN (business_type_tags);
CREATE INDEX IF NOT EXISTS idx_products_visible_in_gin        ON public.products USING GIN (visible_in);
CREATE INDEX IF NOT EXISTS idx_products_purchase_mode_gin     ON public.products USING GIN (purchase_mode);
```

#### [NEW] `supabase/migrations/20260601110000_m27_store_linked_profiles.sql`

```sql
-- جدول الملفات الشخصية المرتبطة بـ DilMart Main
CREATE TABLE IF NOT EXISTS public.store_linked_profiles (
  id                    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  DilMart_user_id        UUID     NULL,
  DilMart_role           TEXT     NULL,
  DilMart_barbershop_id  UUID     NULL,
  store_customer_id     UUID     NULL REFERENCES public.profiles(id) ON DELETE SET NULL,
  segment               TEXT     NOT NULL,
  display_name          TEXT     NULL,
  phone                 TEXT     NULL,
  city                  TEXT     NULL,
  business_type         TEXT     NULL,
  source_app            TEXT     NOT NULL DEFAULT 'store_web',
  last_synced_at        TIMESTAMPTZ NOT NULL DEFAULT now(),
  created_at            TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at            TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_store_linked_profiles_DilMart_user_id
  ON public.store_linked_profiles(DilMart_user_id) WHERE DilMart_user_id IS NOT NULL;

CREATE INDEX IF NOT EXISTS idx_store_linked_profiles_barbershop_id
  ON public.store_linked_profiles(DilMart_barbershop_id);

ALTER TABLE public.store_linked_profiles ENABLE ROW LEVEL SECURITY;
-- Service role فقط يقرأ/يكتب هذا الجدول (من NestJS backend)
```

#### [NEW] `supabase/migrations/20260601120000_m28_orders_source_tracking.sql`

```sql
-- إضافة حقول تتبع المصدر لجدول الطلبات
ALTER TABLE public.orders
  ADD COLUMN IF NOT EXISTS source_app              TEXT NULL,
  ADD COLUMN IF NOT EXISTS segment                 TEXT NULL,
  ADD COLUMN IF NOT EXISTS DilMart_user_id          UUID NULL,
  ADD COLUMN IF NOT EXISTS DilMart_barbershop_id    UUID NULL,
  ADD COLUMN IF NOT EXISTS business_type           TEXT NULL,
  ADD COLUMN IF NOT EXISTS store_linked_profile_id UUID NULL
    REFERENCES public.store_linked_profiles(id) ON DELETE SET NULL;

CREATE INDEX IF NOT EXISTS idx_orders_source_app ON public.orders(source_app);
CREATE INDEX IF NOT EXISTS idx_orders_DilMart_user_id ON public.orders(DilMart_user_id);
```

