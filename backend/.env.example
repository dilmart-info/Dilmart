# ── Required ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer current Secret Key (sb_secret_...) from Dashboard → API Keys.
# Legacy service_role JWT (eyJ...) remains accepted by Batch100 upload tooling as fallback.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key
# Optional Batch100-only overrides (never commit real values):
# BATCH100_SUPABASE_SECRET_KEY=sb_secret_...
# BATCH100_SUPABASE_SERVICE_ROLE_JWT=eyJ...

# Comma-separated list of allowed CORS origins.
# In production include every storefront origin, e.g.:
# https://store.DilMart.org,https://DilMartstore.netlify.app,http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080

# ── Optional — server ──────────────────────────────────────────────────────────
PORT=4000
BODY_LIMIT=12mb

# ── Optional — outbound alert webhooks ────────────────────────────────────────
# Leave blank to disable webhook/email alerts entirely.
OUTBOUND_ALERT_WEBHOOK_URL=
OUTBOUND_ALERT_EMAIL_WEBHOOK_URL=

# Channel order: comma-separated list of "webhook" and/or "email"
OUTBOUND_ALERT_CHANNEL_ORDER=webhook,email
OUTBOUND_ALERT_WEBHOOK_MAX_RETRIES=2

# ── Jenni Logistics (external delivery provider) ─────────────────────────────
JENNI_API_BASE_URL=https://jenni.alzaeemexp.com/api
JENNI_SYSTEM_CODE=
JENNI_USERNAME=
JENNI_PASSWORD=
# Bearer token Jenni uses when calling our webhook (both URLs below accept the same token)
JENNI_WEBHOOK_TOKEN=
# Webhook URLs (register either with Jenni — same handler):
#   POST https://<host>/api/v2/push/update-status
#   POST https://<host>/v2/push/update-status

# ── Jenni Safety Flags (Phase 0 spike script only) ────────────────────────────
# Set to "true" ONLY when you have explicit supervisor approval to create
# real stores or shipments on the Production Jenni account.
ALLOW_REAL_JENNI_STORE_TEST=false
ALLOW_REAL_JENNI_SHIPMENT_TEST=false

# ── Jenni Production Safety Gates ─────────────────────────────────────────────
# Temporary read-only diagnostics endpoint (auth + listStores).
# Set to "true" only during active troubleshooting, then disable.
JENNI_DIAGNOSTICS_ENABLED=false
# Gate for Admin UI "Create Jenni Merchant" button and backend service.
# Must be "true" to allow Merchant provisioning. Default: false (blocked).
# Enable ONLY with supervisor approval, disable after use.
JENNI_ALLOW_MERCHANT_PROVISIONING=false
# Gate for Admin UI "Create / Sync Store" button and backend service.
# Must be "true" to allow Store provisioning. Default: false (blocked).
# Enable ONLY with supervisor approval, disable after use.
JENNI_ALLOW_STORE_PROVISIONING=false
# Gate for Shipment Dispatch.
# Must be "true" to allow shipment creation (Phase 3). Default: false (blocked).
# Enable ONLY with supervisor approval.
JENNI_ALLOW_SHIPMENT_DISPATCH=false

# ── Optional — replay / deduplication ─────────────────────────────────────────
OUTBOUND_REPLAY_WINDOW_MINUTES=60
OUTBOUND_REPLAY_MAX_ATTEMPTS_PER_WINDOW=5
OUTBOUND_REPLAY_SIGNATURE_COOLDOWN_MINUTES=15

# ── OTP delivery (Account Claim / Password Reset) ─────────────────────────────
# Which OTP environment this process is. Only "staging" is accepted by
# scripts/check-otp-staging-readiness.mjs; anything else makes that gate refuse to run,
# which is how a staging smoke is kept away from production by construction.
# One of: staging | production
OTP_ENVIRONMENT=
#
# Operator confirmations for scripts/check-otp-production-readiness.mjs. Neither is
# discoverable from inside the process, so the operator asserts them and the gate records
# it. RENDER_BACKEND_ALWAYS_ON matters because a sleeping free-tier service answers the
# Supabase auth hook with a cold start that blows the five-second budget — the OTP then
# silently never arrives, and nothing in the logs says why.
# RENDER_BACKEND_ALWAYS_ON=CONFIRMED
# RENDER_AUTO_DEPLOY_PAUSED=CONFIRMED
#
# Gates for the phone audit and cleanup scripts. All default off; none belong in a service.
# ALLOW_PHONE_IDENTITY_AUDIT=false
# ALLOW_PHONE_CLUSTER_DETAIL=false
# ALLOW_PHONE_CHANGE_CLEANUP=false
# PHONE_CHANGE_STALE_HOURS=24
# disabled = hard-fail (safe default). fake/test = local/test only (forbidden in production).
# whatsapp = Meta Cloud API (requires all OTP_WHATSAPP_* values below).
OTP_PROVIDER=disabled
# WhatsApp mode: sandbox | live (required when OTP_PROVIDER=whatsapp)
OTP_WHATSAPP_MODE=
OTP_WHATSAPP_PHONE_NUMBER_ID=
OTP_WHATSAPP_ACCESS_TOKEN=
OTP_WHATSAPP_TEMPLATE_NAME=
OTP_WHATSAPP_TEMPLATE_LANGUAGE=
# AUTH_COPY_CODE | AUTH_ONE_TAP | AUTH_GENERIC | AUTH_COPY_CODE_EXPIRY | ...
OTP_WHATSAPP_TEMPLATE_TYPE=
OTP_WHATSAPP_API_VERSION=
OTP_WHATSAPP_TIMEOUT_MS=12000
# Optional: body {{2}} minutes when TEMPLATE_TYPE=AUTH_COPY_CODE_EXPIRY
# OTP_WHATSAPP_EXPIRY_MINUTES=10
# Required in production (must be different strong secrets):
# OTP_HMAC_SECRET=
# OTP_TOKEN_SECRET=
# Keys the AES-256-GCM envelope around opaque OTP request handles.
# Required in production. Must differ from OTP_HMAC_SECRET and OTP_TOKEN_SECRET.
# OTP_REQUEST_HANDLE_SECRET=

# ── Supabase Auth hook (Send SMS -> Meta WhatsApp) ────────────────────────────
# Standard Webhooks secret issued by the Supabase dashboard when the hook is
# enabled. Required for the hook endpoint; requests without a valid signature are
# rejected. Must not be reused for any other purpose.
# SUPABASE_AUTH_HOOK_SECRET=
#
# The hook's per-recipient rate limiter needs its own key so that a limiter bucket can
# never be confused with a signature. It does NOT get a separate variable: the key is
# derived from SUPABASE_AUTH_HOOK_SECRET through a labelled HMAC
# ("auth-hook-recipient-limit:v1"), so the derived value is unusable as a signing secret
# and there is one less secret for an operator to rotate incorrectly. The trade-off is
# that rotating SUPABASE_AUTH_HOOK_SECRET also resets every limiter bucket — acceptable,
# because the buckets are in-memory and already reset on deploy.
#
# Deadline for the hook's own Meta dispatch. Supabase abandons an HTTP auth hook at
# ~5s, so this must stay below that. Allowed range 1000-4500, default 4000. Account
# Claim and the legacy reset paths keep using OTP_WHATSAPP_TIMEOUT_MS.
# SUPABASE_AUTH_HOOK_TIMEOUT_MS=4000
#
# Requires the durable delivery ledger (auth_hook_deliveries + its RPCs) instead of the
# per-process cache. Mandatory in production and implicitly true there regardless of this
# value: without it, a restart, a deploy or a second instance loses the dedupe state and a
# Supabase retry sends a second real WhatsApp message. Set false only for local runs.
OTP_DURABLE_IDEMPOTENCY_REQUIRED=false
# Maintenance gate for scripts/cleanup-auth-hook-deliveries.mjs. Never set in a service.
# ALLOW_AUTH_HOOK_CLEANUP=false
# How long an unexplained (UNCERTAIN) delivery is kept for review before cleanup drops it.
# AUTH_HOOK_UNCERTAIN_RETENTION_DAYS=30
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# ── DilMart Store Integration (B2B Barber App) ─────────────────────────────────
# Shared secret with DilMart Main Backend. Used to verify signed session tokens.
# Generate a strong random value (>= 64 bytes), e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# DO NOT commit the actual secret to git. Keep it in your deployment secrets manager.
DilMart_INTEGRATION_SECRET=
# Expected issuer claim in the incoming integration JWT
DilMart_SESSION_ISSUER=DilMart-main
# Expected audience claim in the incoming integration JWT
DilMart_SESSION_AUDIENCE=DilMart-store
# Store session TTL in seconds (default: 15 minutes)
DilMart_SESSION_TTL_SECONDS=900
